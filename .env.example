# Chaves da Meta para a API do WhatsApp Business Cloud
META_ACCESS_TOKEN="SEU_TOKEN_DE_ACESSO_DA_META"
META_PHONE_NUMBER_ID="SEU_ID_DE_NUMERO_DE_TELEFONE"
META_VERIFY_TOKEN="SEU_TOKEN_DE_VERIFICACAO_WEBHOOK" # Usado para configurar o webhook

# Chave de API da OpenAI (ou outro provedor de IA, se preferir)
# Opcional se estiver usando apenas o Genkit com Gemini
OPENAI_API_KEY="sk-..."

# Configuração do Firebase (geralmente não é necessário aqui se já estiver no código)
# As chaves públicas podem ser expostas com segurança
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="..."
NEXT_PUBLIC_FIREBASE_PROJECT_ID="..."
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="..."
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="..."
NEXT_PUBLIC_FIREBASE_APP_ID="..."

# Conta de serviço do Firebase para ações do lado do servidor (Admin SDK)
# Conteúdo do arquivo JSON da conta de serviço, codificado em Base64
# Execute: cat seu-arquivo-de-servico.json | base64
FIREBASE_SERVICE_ACCOUNT_BASE64="ey..."
